# Optional host port for the Ollama service in docker-compose.yml.
OLLAMA_HOST_PORT=12434

# GitHub image tag for CasaOS: latest, a release such as 1.2.3, or sha-<commit>.
CLIPS_IMAGE_TAG=latest

# Optional data root for compose.casa.yml runtime volumes.
CLIPSCREATOR_APPDATA_DIR=/DATA/AppData/ClipsCreator

# Optional T-shirt design frontend settings.
TSHIRT_FRONTEND_PORT=3002
TSHIRT_FRONTEND_URL=
# Initial default; the UI toggle is saved in data/tshirt-designer/status.json.
TSHIRT_GENERATION_ENABLED=true
TSHIRT_OLLAMA_MODEL=qwen2.5:7b-instruct
TSHIRT_OLLAMA_NUM_PREDICT=6500
TSHIRT_OLLAMA_TEMPERATURE=0.85
TSHIRT_OLLAMA_DESIGN_ATTEMPTS=3
TSHIRT_RECENT_PROMPT_HISTORY=12
TSHIRT_GENERATE_INTERVAL_SECONDS=3600
TSHIRT_IMAGE_PROVIDER=local_diffusion
TSHIRT_LOCAL_IMAGE_FALLBACK_HOSTS=http://clips_image_generator:7860,http://host.docker.internal:7860
# Native model resolution; final PNG downloads are upscaled to TSHIRT_IMAGE_SIZE.
TSHIRT_LOCAL_IMAGE_SIZE=1536
TSHIRT_LOCAL_IMAGE_STEPS=28
TSHIRT_LOCAL_IMAGE_GUIDANCE_SCALE=7.0
TSHIRT_LOCAL_IMAGE_TIMEOUT_SECONDS=3600
TSHIRT_POLLINATIONS_API_KEY=
TSHIRT_POLLINATIONS_MODEL=flux
TSHIRT_POLLINATIONS_IMAGE_SIZE=2048
# Minimum 8000 per axis; smaller configured values are clamped to 8000.
TSHIRT_IMAGE_SIZE=8000
TSHIRT_MAX_DESIGNS=80

# Shared backend/worker Redis connection and clip task monitoring.
REDIS_URL=redis://redis:6379/0
LEAGUECLIPS_WORKER_CONCURRENCY=2
LEAGUECLIPS_AUTO_SYNAPSE_TASK_POLL_SECONDS=30
LEAGUECLIPS_AUTO_SYNAPSE_PENDING_TIMEOUT_SECONDS=300

# Optional local image-generation model settings.
IMAGEGEN_HOST_PORT=7860
IMAGEGEN_MODEL=stabilityai/stable-diffusion-xl-base-1.0
IMAGEGEN_DEVICE=auto
IMAGEGEN_DTYPE=auto
IMAGEGEN_WIDTH=1536
IMAGEGEN_HEIGHT=1536
IMAGEGEN_STEPS=28
IMAGEGEN_GUIDANCE_SCALE=7.0
IMAGEGEN_MODEL_CPU_OFFLOAD=true
